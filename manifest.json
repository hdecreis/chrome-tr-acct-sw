{
  "manifest_version": 3,
  "name": "Trade Republic — Account Switcher",
  "version": "0.4.0",
  "description": "Toggle between Brokerage (CTO) and PEA across the entire Trade Republic UI.",
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": [
    "https://app.traderepublic.com/*",
    "https://api.traderepublic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.traderepublic.com/*"],
      "js": ["intercept.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://app.traderepublic.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://app.traderepublic.com/*"],
      "js": ["ui.js"],
      "css": ["panel.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
